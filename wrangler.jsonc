{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quilon-site",
	"compatibility_date": "2026-08-24",
	"main": "src/index.js",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "quilon.run",
			"custom_domain": true
		},
		{
			"pattern": "www.quilon.run",
			"custom_domain": true
		}
	]
}
